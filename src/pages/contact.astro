---

<BaseLayout
  name={siteMetadata.name}
  title={siteMetadata.title}
  description={siteMetadata.description}
  keywords={siteMetadata.keywords}>
  <section>
    <Card className='w-full max-w-2xl mx-auto'>
      <CardHeader>
        <CardTitle>
          <h1>Feel free to connect with me</h1>
        </CardTitle>
        <CardDescription>
          <p>
            You can reach me via email at <a
              target='_blank'
              href={`mailto:${siteMetadata.email}`}
              class={buttonVariants({
                variant: 'link',
                size: 'sm',
                className: 'px-0!',
              })}>{siteMetadata.email}</a
            > or connect with me on social media platforms like <a
              target='_blank'
              href={siteMetadata.socials.twitter}
              class={buttonVariants({
                variant: 'link',
                size: 'sm',
                className: 'px-0!',
              })}>Twitter</a
            >, <a
              target='_blank'
              href={siteMetadata.socials.linkedin}
              class={buttonVariants({
                variant: 'link',
                size: 'sm',
                className: 'px-0!',
              })}>LinkedIn</a
            >, and <a
              target='_blank'
              href={siteMetadata.socials.github}
              class={buttonVariants({
                variant: 'link',
                size: 'sm',
                className: 'px-0!',
              })}>GitHub</a
            >.
          </p>
        </CardDescription>
      </CardHeader>

      <CardContent>
        <ContactForm client:load />
      </CardContent>
    </Card>
  </section>
</BaseLayout>
