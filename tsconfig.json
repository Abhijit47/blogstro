{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "#/*": [
        "src/*"
      ],
      "#components/*": [
        "src/components/*"
      ],
      "#lib/*": [
        "src/lib/*"
      ],
      "#hooks/*": [
        "src/hooks/*"
      ]
    }
  }
}